\renewcommand{\normalsize}{\fontsize{10}{11}\selectfont}

% ============================================================
% SECTION HEADINGS
% ============================================================

\titleformat{\section}
    {\fontsize{11}{12}\selectfont\bfseries}
    {}
    {0pt}
