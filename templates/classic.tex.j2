    [\vspace{1pt}\titlerule]

\titlespacing*{\section}
    {0pt}
    {5pt}
    {3pt}

% ============================================================
% TECHNICAL SKILLS ROW
% ============================================================

\newcommand{\skillrow}[2]{%
    {\fontsize{10}{10.2}\selectfont
    \noindent
    \begin{tabularx}{\textwidth}{@{}p{1.55in}@{\hspace{4pt}}X@{}}
        {\bfseries #1} & #2
    \end{tabularx}
    }
}

% ============================================================
% EXPERIENCE COMPANY HEADER
% ============================================================

\newcommand{\experienceheader}[2]{%
    \noindent
    \begin{tabularx}{\textwidth}{@{}Xr@{}}
        {\fontsize{10}{11}\selectfont\bfseries #1}
        &
        {\fontsize{10}{11}\selectfont\bfseries #2}
    \end{tabularx}
    \vspace{-2.5pt}
}

% ============================================================
% EXPERIENCE BULLETS
% Slightly increased line spacing
% ============================================================

\newenvironment{experiencebullets}
{%
    \begin{itemize}[
        leftmargin=0.18in,
        label=\textbullet,
        labelsep=0.07in,
        itemsep=0pt,
        topsep=0pt,
        parsep=0pt,
        partopsep=0pt
    ]
    \fontsize{10}{11}\selectfont
}
{%
    \end{itemize}
}

