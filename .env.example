# Copy this file to `.env` and fill in your values.
# `.env` is ignored by git. Never commit real keys.

# Groq (free tier): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# 0 = same answer every time, 1 = more creative. Low is better for resumes.
LLM_TEMPERATURE=0.2

# Max output tokens. Reasoning models "think" inside this limit too, so keep it big.
LLM_MAX_TOKENS=8192
# low | medium | high. How long the model thinks before answering.
LLM_REASONING_EFFORT=low

# Database. Empty = local SQLite file in storage/. Server: postgresql+psycopg://user:pass@host:5432/db
DATABASE_URL=

# API. In prod set ENVIRONMENT=prod and a long random JWT_SECRET:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ENVIRONMENT=dev
JWT_SECRET=
