# Copy this file to `.env` and fill in your values.
# `.env` is ignored by git. Never commit real keys.

# ---------- LLM providers (both have free tiers) ----------
# Order in which providers are tried. If the first fails, the next is used.
LLM_PROVIDERS=groq,gemini

# Groq: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 0 = same answer every time, 1 = more creative. Low is better for resumes.
LLM_TEMPERATURE=0.2
